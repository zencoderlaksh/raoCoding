# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Clerk Authentication (Optional / Social Sign-In)
CLERK_PUBLISHABLE_KEY=pk_test_YXB0LWFtb2ViYS03NS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Cloudinary Storage (Optional - File uploads fallback to local if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Optional - DodoPayments)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# Email / SMTP (RAO Technologies)
EMAIL_USER=raotechnologies5@gmail.com
EMAIL_PASS=your_email_password_or_app_password
