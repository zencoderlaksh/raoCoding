# ==============================================================================
# RaoCoding Backend Environment Configuration Template
# Duplicate this file to .env and fill in your actual credentials.
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.abcde.mongodb.net/raocoding?retryWrites=true&w=majority

# Clerk Authentication (https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_YXB0LWFtb2ViYS03NS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# Clerk Webhook Secret (https://dashboard.clerk.com -> Webhooks)
CLERK_WEBHOOK_SECRET=

# Admin Email (Auto-grants admin role in MongoDB)
ADMIN_EMAIL=admin@raocoding.com

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Dodo Payments
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_payments_webhook_key
